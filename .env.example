# Used only by the separate, opt-in read-only hardware example.
# Do not commit .env files or real BMC credentials.
BMC_URL=https://bmc.example
BMC_USERNAME=observer
BMC_PASSWORD=
BMC_CA_BUNDLE=

# Optional external OTLP/HTTP Collector origin for the Gradio lab or hardware example.
# Export this variable in your shell; the app does not auto-load .env.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
